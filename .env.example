# =============================================================================
# Warehouse_BE_V2 — Environment Variables
# =============================================================================
# Copy file này thành `.env` và điền giá trị thật cho từng biến.
# KHÔNG bao giờ commit file `.env` (đã có trong .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development            # development | production | test
PORT=3000                       # Port server lắng nghe

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
# Cách 1: dùng từng biến riêng (khuyến nghị cho local)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=warehouse_admin
POSTGRES_PASSWORD=ChangeMe@123
POSTGRES_DB=smart_warehouse

# Cách 2: dùng connection URL (override các biến trên, dùng cho cloud DB)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# -----------------------------------------------------------------------------
# JWT (JSON Web Token)
# -----------------------------------------------------------------------------
# Tạo secret an toàn bằng:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ChooseAVeryLongRandomStringAtLeast64CharactersForProductionUsage
JWT_EXPIRES_IN=7d               # Ví dụ: 1h, 12h, 7d, 30d

# -----------------------------------------------------------------------------
# Email (cho OTP đổi mật khẩu, notification)
# -----------------------------------------------------------------------------
# Service mặc định là 'gmail' với App Password.
# Để bật, vào: https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail             # gmail | smtp
EMAIL_USER=your.email@gmail.com
EMAIL_APP_PASSWORD=xxxx yyyy zzzz wwww   # 16 ký tự App Password (Gmail)

# Nếu dùng custom SMTP (Outlook, SendGrid, Mailgun, …):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false               # true cho port 465, false cho 587
# EMAIL_PASSWORD=                # (nếu cần password thay vì App Password)

# -----------------------------------------------------------------------------
# Cloudinary (upload ảnh SKU / sản phẩm)
# -----------------------------------------------------------------------------
# Đăng ký miễn phí: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# -----------------------------------------------------------------------------
# CORS (production)
# -----------------------------------------------------------------------------
# Whitelist các origin FE được phép gọi API. Trống = cho phép mọi origin (dev).
# CORS_ORIGINS=https://app.warehouse.example.com,https://admin.warehouse.example.com

# -----------------------------------------------------------------------------
# Rate limiting (kế hoạch, chưa active)
# -----------------------------------------------------------------------------
# RATE_LIMIT_WINDOW_MS=60000     # 1 phút
# RATE_LIMIT_MAX=100             # 100 req / window

# -----------------------------------------------------------------------------
# Logging (kế hoạch)
# -----------------------------------------------------------------------------
# LOG_LEVEL=info                 # error | warn | info | debug
# LOG_PRETTY=true                # in JSON đẹp ra console khi dev

# -----------------------------------------------------------------------------
# External services (sẽ tích hợp)
# -----------------------------------------------------------------------------
# AI_SLOT_SERVICE_URL=http://localhost:8000
# AI_SLOT_SERVICE_API_KEY=

# -----------------------------------------------------------------------------
# Sentry (production error tracking — kế hoạch)
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
# SENTRY_ENVIRONMENT=production

# =============================================================================
# CHECKLIST KHI TẠO .env LẦN ĐẦU
# =============================================================================
# [ ] Đổi JWT_SECRET thành chuỗi random ≥ 64 ký tự
# [ ] POSTGRES_PASSWORD đủ mạnh
# [ ] Tạo Gmail App Password (sau khi bật 2FA Google)
# [ ] EMAIL_USER + EMAIL_APP_PASSWORD đúng
# [ ] Đăng ký Cloudinary account + lấy 3 biến
# [ ] CORS_ORIGINS đúng domain FE (production)
# [ ] Đặt NODE_ENV=production trên server thật
# =============================================================================
